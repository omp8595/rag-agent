# Copy to .env for local overrides. Never commit the real .env file.
# Every variable has a working default - the service starts and every
# endpoint except a real-LLM request works with none of this set at all.

# --- Service (context_layer/api/config.py) ---
APP_ENV=demo
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
DATA_MODE=synthetic
EVAL_MODE=fast

# --- Optional real LLM, shared by RealLLMProvider (live responses) and
# the evaluation layer (RAGAS/DeepEval/LLM-Judge) - context_layer/evaluation/config.py ---
# Leave all unset to stay in mock mode: no paid API calls, no external
# service dependency, every endpoint still works. Set at most one
# provider's key. EVAL_LLM_PROVIDER/EVAL_MODEL are accepted too, checked
# first, for callers that want evaluation to use a different model than
# live responses.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
